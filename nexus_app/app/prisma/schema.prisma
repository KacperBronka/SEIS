generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  nick         String   @unique
  email        String   @unique
  passwordHash String
  ageVerified  Boolean  @default(false)
  seisToken    String?
  createdAt    DateTime @default(now())
}

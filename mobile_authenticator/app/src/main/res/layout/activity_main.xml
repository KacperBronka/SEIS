<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Background decorative circle top -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_circle_top" />

    <!-- Background decorative circle bottom -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"
        android:background="@drawable/bg_circle_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="#7C3AED"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SEIS"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:fontFamily="sans-serif-medium"/>

            <!-- Status dot -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_offline"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:fontFamily="sans-serif"/>
            <Button
                android:id="@+id/btnFamily"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="👨‍👩‍👧"
                android:textSize="16sp"
                android:background="@drawable/bg_btn_back"
                android:stateListAnimator="@null"
                android:padding="0dp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <!-- User card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Avatar circle -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar"
                    android:layout_marginEnd="14dp">

                    <TextView
                        android:id="@+id/txtInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="JK"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jan Kowalski"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E"/>

                    <TextView
                        android:id="@+id/txtUserId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: ZZC108201"
                        android:textSize="12sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Edit ID -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <EditText
                        android:id="@+id/editTextMessage"
                        android:layout_width="100dp"
                        android:layout_height="36dp"
                        android:hint="Change ID"
                        android:textSize="11sp"
                        android:textColor="#1A1A2E"
                        android:background="@drawable/bg_edit_text"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:inputType="text"
                        android:singleLine="true"/>

                    <Button
                        android:id="@+id/buttonSet"
                        android:layout_width="100dp"
                        android:layout_height="30dp"
                        android:text="Apply"
                        android:textSize="11sp"
                        android:textColor="#7C3AED"
                        android:background="@android:color/transparent"
                        android:padding="0dp"
                        android:layout_marginTop="2dp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CODE CARD — main focus -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#7C3AED">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="32dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCESS CODE"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textColor="#DDD6FE"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Code display — 6 individual digit boxes -->
                <LinearLayout
                    android:id="@+id/codeBoxRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/digit1"
                        android:layout_width="40dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_digit_box"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/digit2"
                        android:layout_width="40dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_digit_box"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/digit3"
                        android:layout_width="40dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_digit_box"
                        android:layout_marginEnd="14dp"/>

                    <TextView
                        android:id="@+id/digit4"
                        android:layout_width="40dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_digit_box"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/digit5"
                        android:layout_width="40dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_digit_box"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/digit6"
                        android:layout_width="40dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_digit_box"/>
                </LinearLayout>

                <!-- Timer ring + countdown -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <com.example.nfc_writer.TimerRingView
                        android:id="@+id/timerRing"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"/>

                    <TextView
                        android:id="@+id/txtTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="5:00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="monospace"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Code expires automatically"
                    android:textSize="11sp"
                    android:textColor="#C4B5FD"
                    android:layout_marginBottom="24dp"/>

                <!-- Generate button -->
                <Button
                    android:id="@+id/btnCodeGen"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Generate Code"
                    android:textSize="15sp"
                    android:textColor="#7C3AED"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_white"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Accept request card — hidden by default -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAccept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#F5F3FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="⚠️"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Access Request"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"/>

                        <TextView
                            android:id="@+id/txtRequestMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="#6B7280"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDecline"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="✕ Decline"
                        android:textSize="14sp"
                        android:textColor="#7C3AED"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_decline_soft"
                        android:stateListAnimator="@null"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        android:id="@+id/btnAccept"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="✓ Approve"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_purple_soft"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
<Window x:Class="Discord_clone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Discord_clone"
        mc:Ignorable="d"
        Title="Discord Clone - Weryfikacja" Height="550" Width="450"
        Background="#313338" WindowStartupLocation="CenterScreen"
        AllowsTransparency="False" WindowStyle="SingleBorderWindow">

	<Grid Margin="40">
		<StackPanel VerticalAlignment="Center">

			<TextBlock Text="Weryfikacja Konta"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

			<TextBlock Text="Wprowadź kod weryfikacyjny, aby potwierdzić swój wiek."
                       Foreground="#B5BAC1"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,35"/>

			<TextBlock Text="WYMAGANY WIEK"
                       Foreground="#B5BAC1"
                       FontSize="12"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>
			<Border Background="#1E1F22" CornerRadius="4" Padding="12" Margin="0,0,0,20">
				<StackPanel Orientation="Horizontal">
					<Ellipse Width="8" Height="8" Fill="#23A559" Margin="0,0,10,0"/>
					<TextBlock Text="Użytkownik musi mieć ukończone 18 lat"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<TextBlock Text="TWÓJ KOD WERYFIKACYJNY"
                       Foreground="#B5BAC1"
                       FontSize="12"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>
			<TextBox x:Name="VerificationCodeInput"
                     Background="#1E1F22"
                     Foreground="White"
                     BorderThickness="0"
                     FontSize="32"
                     FontWeight="ExtraBold"
                     Padding="10"
                     HorizontalContentAlignment="Center"
                     MaxLength="6"
                     SelectionBrush="#5865F2"
                     CaretBrush="White">
				<TextBox.Resources>
					<Style TargetType="{x:Type Border}">
						<Setter Property="CornerRadius" Value="4"/>
					</Style>
				</TextBox.Resources>
			</TextBox>

			<Button x:Name="VerifyButton"
                    Content="Potwierdź profil"
                    Margin="0,30,0,15"
                    Height="48"
                    Background="#5865F2"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="VerifyButton_Click">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="4"/>
					</Style>
				</Button.Resources>
				<Button.Style>
					<Style TargetType="Button">
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}" CornerRadius="4">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#4752C4"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>

			<Grid x:Name="LoadingPanel" Visibility="Collapsed">
				<StackPanel>
					<ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#5865F2"
                                 Margin="0,5"/>
					<TextBlock x:Name="StatusLabel"
                               Text="Czekam na potwierdzenie przez serwer (max 60s)..."
                               Foreground="#B5BAC1"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
				</StackPanel>
			</Grid>

		</StackPanel>
	</Grid>
</Window>

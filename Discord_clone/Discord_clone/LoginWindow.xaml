<Window x:Class="Discord_clone.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Clone - Logowanie"
        Height="500" Width="400"
        Background="#313338"
        WindowStartupLocation="CenterScreen">

	<StackPanel Margin="30" VerticalAlignment="Center">

		<TextBlock Text="Rejestracja / Logowanie"
                   Foreground="White"
                   FontSize="24"
                   Margin="0,0,0,20"/>

		<!-- NICK -->
		<TextBlock Text="Nick" Foreground="Gray" Margin="0,5,0,2"/>
		<TextBox x:Name="NickInput"
                 Height="30"
                 Background="#1E1F22"
                 Foreground="White"
                 BorderBrush="#5865F2"
                 BorderThickness="1"
                 Padding="5"/>

		<!-- EMAIL -->
		<TextBlock Text="Email" Foreground="Gray" Margin="0,10,0,2"/>
		<TextBox x:Name="EmailInput"
                 Height="30"
                 Background="#1E1F22"
                 Foreground="White"
                 BorderBrush="#5865F2"
                 BorderThickness="1"
                 Padding="5"/>

		<!-- HASŁO -->
		<TextBlock Text="Hasło" Foreground="Gray" Margin="0,10,0,2"/>
		<PasswordBox x:Name="PasswordInput"
                     Height="30"
                     Background="#1E1F22"
                     Foreground="White"
                     BorderBrush="#5865F2"
                     BorderThickness="1"
                     Padding="5"/>

		<!-- POWTÓRZ HASŁO -->
		<TextBlock Text="Powtórz hasło" Foreground="Gray" Margin="0,10,0,2"/>
		<PasswordBox x:Name="PasswordRepeatInput"
                     Height="30"
                     Background="#1E1F22"
                     Foreground="White"
                     BorderBrush="#5865F2"
                     BorderThickness="1"
                     Padding="5"/>

		<!-- CHECKBOX 18+ -->
		<CheckBox x:Name="AgeCheckBox"
                  Content="Mam ukończone 18 lat"
                  Foreground="White"
                  Margin="0,15,0,0"
                  Click="AgeCheckBox_Click"/>

		<!-- PRZYCISK LOGOWANIA -->
		<Button Content="Zarejestruj / Zaloguj"
                Margin="0,20,0,0"
                Height="40"
                Background="#5865F2"
                Foreground="White"
                FontWeight="SemiBold"
                Click="RegisterLoginButton_Click"/>
	</StackPanel>
</Window>
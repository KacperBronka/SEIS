<Window x:Class="ProductApp.AutoCloseMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="140" Width="320" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Background="Transparent"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True">

	<Border CornerRadius="12"
            Background="White"
            BorderBrush="#FFEEEEEE"
            BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="6"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Czerwony pasek na górze jak w nagłówku głównego okna -->
			<Border Grid.Row="0"
                    Background="#FFD32F2F"
                    CornerRadius="12,12,0,0"/>

			<!-- Treść -->
			<StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="20,16,20,20">

				<TextBlock Text="🛒" FontSize="22"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

				<TextBlock x:Name="MessageText"
                           Text="Treść wiadomości"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FF424242"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="20"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>